{
  // The tillmorning.co.uk website: static pages in public/, served by Cloudflare.
  // Deploy: npx wrangler deploy (from this folder).
  "name": "tillmorning-site",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash" },
  "routes": [
    { "pattern": "tillmorning.co.uk", "custom_domain": true },
    { "pattern": "www.tillmorning.co.uk", "custom_domain": true }
  ]
}
