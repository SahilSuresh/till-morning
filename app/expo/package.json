{
  "name": "till-morning",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.17",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-observe": "~58.0.16",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-device-activity": "^0.6.1",
    "react-native-purchases": "^10.15.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "preflight": "npm run typecheck && npm run lint && npx expo-doctor",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "build:ios": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --profile production --platform ios --latest",
    "update": "eas update --channel production --environment production && npx sentry-expo-upload-sourcemaps dist"
  },
  "private": true
}
