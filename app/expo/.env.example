# Copy to .env.local for local `expo start` only. Never commit real values.
# Builds read these from EAS environment variables instead (see docs/setup-commands.md).
APP_ENV=development
APPLE_TEAM_ID=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN goes in EAS as a secret, not here.
