{
  "expo": {
    "name": "Till Morning",
    "slug": "till-morning",
    "scheme": "tillmorning",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0F2E",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F2E"
    },
    "ios": {
      "bundleIdentifier": "com.andrej.tillmorning",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "platforms": [
      "ios"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appEnv": "development",
      "appGroup": "group.com.andrej.tillmorning",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.andrej.tillmorning.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.andrej.tillmorning"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.andrej.tillmorning.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.andrej.tillmorning"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.andrej.tillmorning.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.andrej.tillmorning"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "bec5851e-deb4-42ae-a7ae-dbb24a6d0c9f"
      }
    },
    "owner": "sahil-suresh"
  }
}
