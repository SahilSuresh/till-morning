{
  "expo": {
    "name": "Till Morning",
    "slug": "till-morning",
    "scheme": "tillmorning",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0F2E",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F2E"
    },
    "ios": {
      "bundleIdentifier": "com.andrej.tillmorning",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "platforms": [
      "ios"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
